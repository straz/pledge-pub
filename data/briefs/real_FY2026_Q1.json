    "statement": {
      "id": "REAX-FY2026Q1-049",
      "claim": "Real Brokerage expects to reach 2x net debt to adjusted EBITDA by the end of the second full fiscal year following the close of the RE/MAX acquisition.\n",
      "verbatim_quote": "Our first capital allocation priority post-close will be deleveraging, and we expect to reach the 2x net debt to adjusted EBITDA by the end of the second full fiscal year following close.",
      "speaker": {
        "id": "ravi-jani",
        "name": "Ravi Jani",
        "role": "CFO at The Real Brokerage"
      },
      "location": {
        "turn_index": 94,
        "timestamp": "00:41:52"
      },
      "passage": {
        "before": "We're approaching leverage very conservatively, and we're encouraged because both businesses are highly cash generative. They're asset light. RE/MAX brings recurring franchise revenue, which creates a lot of visibility into the future free cash flow of the company.",
        "highlight": "Our first capital allocation priority post-close will be deleveraging, and we expect to reach the 2x net debt to adjusted EBITDA by the end of the second full fiscal year following close.",
        "after": "As we de-lever, we'll see both a stronger balance sheet and stronger earnings as we reduce the associated interest expense. We think the debt balance is quite manageable."
      },
      "classification": {
        "hedging": {
          "value": "softly_hedged",
          "label": "Softly hedged",
          "explanation": "The CFO qualified the target with \"we expect\" rather than asserting it as certain. The softening reflects that delevering pace depends on post-close operating results and integration execution, both of which remain uncertain at the time of the call."
        },
        "override_window": {
          "value": "mid-horizon",
          "label": "Mid-horizon",
          "range": "12–24 months",
          "explanation": "The commitment covers the second full fiscal year following close. With a targeted H2 2026 close, resolution requires the FY2028 annual report — approximately 24–30 months from the call date."
        },
        "categorizations": [
          {
            "id": "financial_structure_or_capital_action",
            "label": "Capital structure"
          }
        ],
        "resolution": {
          "finding": "unresolved",
          "label": "Unresolved",
          "as_of": "2026-05-08T00:00:00.000Z",
          "explanation": "The RE/MAX acquisition has not yet closed. This commitment becomes evaluable only after close and will be measured against the net debt to adjusted EBITDA ratio disclosed in the second full fiscal year following the close date."
        }
      },
